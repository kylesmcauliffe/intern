---
// Fundations
import BaseLayout from "@/layouts/BaseLayout.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Button from "@/components/fundations/elements/Button.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
// Components
import BlogCard1 from "@/components/blog/BlogCard1.astro";
import CtaSubscribe from "@/components/ctas/CtaSubscribe.astro";
// Content
import { getCollection } from "astro:content";

const allPosts = await getCollection("posts");
allPosts.sort((a, b) => {
  const dateA = new Date(a.data.pubDate).getTime();
  const dateB = new Date(b.data.pubDate).getTime();
  return dateB - dateA;
});
const tags = [...new Set(allPosts.map((post) => post.data.tags).flat())];
---

<BaseLayout>
  <section class="bg-white overflow-hidden relative">
    <Wrapper variant="standardWide" class="px-8 pb-0 py-12 lg:pt-24">
      <div class="max-w-3xl mx-auto">
        <Text
          tag="h1"
          variant="displayXL"
          class="tracking-tighter text-accent-800 text-balance"
        >
          Notes from the journey
        </Text>
        <Text tag="p" variant="textLG" class="font-medium text-base-600 mt-6">
          Career lessons, honest reflections, and conversations about figuring out
          what comes next.
        </Text>
        <div class="mt-8 rounded-2xl bg-base-100 border border-base-200 p-8">
          <Text tag="p" variant="textBase" class="text-base-700">
            A collection of essays, advice, and conversations from The Return Offer,
            the Intern → Impact newsletter.
          </Text>
          <a
            href="/blog"
            class="mt-4 inline-flex items-center text-sm font-semibold uppercase tracking-widest text-accent-600 hover:text-accent-800"
          >
            Read on Substack →
          </a>
        </div>
        <div class="mt-8">
          <Button isLink size="base" variant="accent" href="/apply">
            Join the newsletter
          </Button>
        </div>
      </div>
    </Wrapper>
  </section>
  <section>
    <div class="bg-white 2xl:max-w-7xl mx-auto overflow-hidden relative">
      <img
        src="/shapes/2.svg"
        class="absolute w-full h-full opacity-[0.1] z-0 -left-64 sm:-left-96 -bottom-96"
        alt=""
      />
      <div class="px-8 py-12 mx-auto max-w-6xl md:px-16 space-y-24">
        <div
          class="relative flex flex-wrap justify-start gap-2 max-w-xl ml-auto"
        >
          {
            tags.map((tag, index) => (
              <>
                <a
                  class="text-sm text-accent-500 font-medium hover:text-accent-700"
                  href={`/blog/tags/${tag}`}
                >
                  {tag}
                </a>
                {index < tags.length - 1 && <span class="mx-1">·</span>}
              </>
            ))
          }
        </div>
        <dl class="grid sm:grid-cols-2 lg:grid-cols-3 gap-x-12 gap-y-24">
          {allPosts.map((post) => <BlogCard1 post={post} />)}
        </dl>
      </div>
    </div>
  </section>
  <CtaSubscribe />
</BaseLayout>
