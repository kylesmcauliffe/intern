---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import CtaHire from "@/components/ctas/CtaHire.astro";
import {
  featuredOpportunities,
  internshipCategories,
  earlyCareerCategories,
  getOpportunitiesByCategory,
} from "@/data/opportunities";

const thisMonth = featuredOpportunities.slice(0, 5);
---

<BaseLayout>
  <section class="bg-white overflow-hidden relative">
    <Wrapper variant="standard" class="py-12 lg:pt-24 pb-16">
      <div class="max-w-3xl">
        <Text
          tag="h1"
          variant="displayLG"
          class="tracking-tighter text-accent-800 text-balance"
        >
          The Opportunity Board
        </Text>
        <Text tag="p" variant="textLG" class="text-base-600 mt-6 text-balance">
          Curated opportunities from LinkedIn that I genuinely think are worth
          knowing about — updated weekly.
        </Text>
      </div>

      <div class="mt-16">
        <Text tag="h2" variant="displaySM" class="text-base-900">
          Applications Open This Month
        </Text>
        <p class="mt-2 text-sm text-base-500">
          Featured in the newsletter: 5 opportunities worth applying to this month.
        </p>
        <ul class="mt-8 divide-y divide-base-200 border-t border-base-200">
          {
            thisMonth.map((job) => (
              <li class="py-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
                <div>
                  <p class="text-xs font-medium uppercase tracking-widest text-accent-600">
                    {job.datePosted}
                  </p>
                  <p class="mt-1 text-lg font-semibold text-base-900">
                    {job.title}
                  </p>
                  <p class="text-sm text-base-600">
                    {job.company} — {job.description}
                  </p>
                </div>
                <a
                  href={job.link}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex shrink-0 items-center text-sm font-medium text-accent-600 hover:text-accent-800"
                >
                  View on LinkedIn →
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="mt-20">
        <Text tag="h2" variant="displaySM" class="text-base-900">
          Internships
        </Text>
        <div class="mt-8 space-y-12">
          {
            internshipCategories.map((category) => {
              const jobs = getOpportunitiesByCategory(category);
              return (
                <div>
                  <h3 class="text-sm font-semibold uppercase tracking-widest text-base-500">
                    {category}
                  </h3>
                  {jobs.length > 0 ? (
                    <ul class="mt-4 space-y-4">
                      {jobs.map((job) => (
                        <li class="rounded-2xl border border-base-200 bg-base-50 p-5">
                          <p class="font-medium text-base-900">{job.title}</p>
                          <p class="mt-1 text-sm text-base-600">
                            {job.company} — {job.description}
                          </p>
                          <a
                            href={job.link}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="mt-3 inline-block text-sm font-medium text-accent-600 hover:text-accent-800"
                          >
                            Apply →
                          </a>
                        </li>
                      ))}
                    </ul>
                  ) : (
                    <p class="mt-3 text-sm text-base-500">
                      Updated weekly — check back soon.
                    </p>
                  )}
                </div>
              );
            })
          }
        </div>
      </div>

      <div class="mt-20">
        <Text tag="h2" variant="displaySM" class="text-base-900">
          Early Career
        </Text>
        <div class="mt-8 grid gap-6 sm:grid-cols-2">
          {
            earlyCareerCategories.map((category) => {
              const jobs = getOpportunitiesByCategory(category);
              return (
                <div class="rounded-2xl border border-base-200 bg-white p-6">
                  <h3 class="font-semibold text-base-900">{category}</h3>
                  {jobs.length > 0 ? (
                    <ul class="mt-4 space-y-3">
                      {jobs.map((job) => (
                        <li>
                          <a
                            href={job.link}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="text-sm text-base-700 hover:text-accent-700"
                          >
                            {job.title} at {job.company}
                          </a>
                        </li>
                      ))}
                    </ul>
                  ) : (
                    <p class="mt-3 text-sm text-base-500">
                      Updated weekly — new listings coming soon.
                    </p>
                  )}
                </div>
              );
            })
          }
        </div>
      </div>
    </Wrapper>
  </section>
  <CtaHire />
</BaseLayout>
