---
// Assets
import BrandLogo from "@/components/assets/BrandLogo.astro";
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";

const navLinks = [
  { name: "Home", href: "/" },
  { name: "Work", href: "/work" },
  { name: "Blog", href: "/blog" },
  { name: "Apply", href: "/apply" },
  { name: "About", href: "/about" },
];
---

<footer class="bg-base-50 overflow-hidden relative px-4 pb-8 pt-8 lg:px-8">
  <div
    class="relative overflow-hidden rounded-[2rem] bg-gradient-to-r from-pink-200 via-yellow-100 to-accent-100 px-8 py-16 lg:px-16"
  >
    <Wrapper variant="standard" class="relative">
      <div
        class="flex flex-col gap-10 sm:flex-row sm:items-start sm:justify-between"
      >
        <div>
          <BrandLogo />
          <Text tag="p" variant="textSM" class="mt-4 max-w-sm text-base-700">
            For those figuring out corporate life as they go.
          </Text>
        </div>
        <nav aria-label="Footer">
          <ul class="flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:gap-x-6 sm:gap-y-2">
            {
              navLinks.map((item) => (
                <li>
                  <a
                    class="text-sm font-medium text-base-800 hover:text-base-950 duration-200"
                    href={item.href}
                  >
                    {item.name}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
      <p class="mt-12 text-sm text-base-600">
        © {new Date().getFullYear()} Intern to Impact. All rights reserved.
      </p>
    </Wrapper>
  </div>
</footer>
