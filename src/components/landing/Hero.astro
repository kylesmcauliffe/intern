---
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import Button from "@/components/fundations/elements/Button.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
---

<section class="bg-base-50 overflow-hidden relative">
  <Wrapper variant="standardWide" class="px-8 py-16 lg:py-24">
    <div class="mx-auto max-w-3xl text-center">
      <Text
        tag="h1"
        variant="displayXL"
        class="tracking-tight text-base-900 text-balance lowercase"
      >
        intern to <em class="italic font-normal not-lowercase">impact</em>
      </Text>
      <Text
        tag="p"
        variant="textBase"
        class="mt-6 text-base-600 max-w-xl mx-auto"
      >
        For those figuring out corporate life as they go
      </Text>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
        <Button isLink size="base" variant="default" href="/apply">
          Join the newsletter
        </Button>
      </div>
    </div>
  </Wrapper>
</section>
