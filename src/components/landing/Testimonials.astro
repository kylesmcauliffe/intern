---
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";

const testimonials = [
  {
    quote:
      "Nobody handed me a playbook. I applied to over 100 internships and learned that one conversation often mattered more than fifty cold applications.",
    name: "Ariana Cirkelis",
    role: "From How to get a coffee chat",
    href: "/blog/posts/coffee-chat",
  },
  {
    quote:
      "Company visits are great for vibe — but I wish someone had walked me through what people actually do in their first role. That clarity changed how I applied and interviewed.",
    name: "Ariana Cirkelis",
    role: "From What an SDR actually does all day",
    href: "/blog/posts/sdr-day-in-the-life",
  },
  {
    quote:
      "The final presentation structure Jenna used to convert her summer internship into a full-time return offer — shared with her permission.",
    name: "Community Portfolio",
    role: "Jenna's return offer presentation",
    href: "/work/community-jenna-presentation",
  },
];
---

<section class="bg-base-50 overflow-hidden relative">
  <Wrapper variant="standard" class="py-24">
    <span
      class="inline-flex rounded-full bg-base-200 px-3 py-1 text-[11px] font-medium uppercase tracking-widest text-base-600"
    >
      Voices
    </span>
    <Text
      tag="h2"
      variant="displayMD"
      class="tracking-tight text-base-900 mt-6 text-balance max-w-2xl"
    >
      Notes and stories from the journey
    </Text>
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3 mt-12">
      {
        testimonials.map((testimonial) => (
          <figure class="flex flex-col rounded-3xl border border-base-200 bg-white p-8 shadow-sm">
            <blockquote class="text-base text-base-800 flex-1">
              <p>“{testimonial.quote}”</p>
            </blockquote>
            <figcaption class="mt-6">
              <Text tag="h3" variant="textBase" class="font-semibold text-base-900">
                {testimonial.name}
              </Text>
              <p class="mt-1 text-xs text-base-500">{testimonial.role}</p>
              <a
                href={testimonial.href}
                class="mt-4 inline-flex items-center gap-1 text-sm font-medium text-accent-600 hover:text-accent-800"
              >
                Read more →
              </a>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </Wrapper>
</section>
