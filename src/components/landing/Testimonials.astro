---
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";

const testimonials = [
  {
    quote:
      "Seeing Sofia's Spotify deck made me realize my internship project could actually become portfolio work—not just a line on my resume.",
    name: "Maya Chen",
    role: "Marketing Intern, Class of 2027",
    href: "/work/community-sofia-spotify",
  },
  {
    quote:
      "Jenna's return-offer presentation showed me what 'good' looks like before my final review. I copied the structure and it changed everything.",
    name: "Priya Patel",
    role: "Strategy Intern, Bay Area",
    href: "/work/community-jenna-presentation",
  },
  {
    quote:
      "The coffee chat guide got me three conversations in one week. I finally stopped overthinking the outreach message.",
    name: "Jordan Ellis",
    role: "Business Development Intern",
    href: "/blog/posts/coffee-chat",
  },
];
---

<section class="bg-base-50 overflow-hidden relative">
  <Wrapper variant="standard" class="py-24">
    <span
      class="inline-flex rounded-full bg-base-200 px-3 py-1 text-[11px] font-medium uppercase tracking-widest text-base-600"
    >
      Voices
    </span>
    <Text
      tag="h2"
      variant="displayMD"
      class="tracking-tight text-base-900 mt-6 text-balance max-w-2xl"
    >
      Interns and partners have something to say
    </Text>
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3 mt-12">
      {
        testimonials.map((testimonial) => (
          <figure class="flex flex-col rounded-3xl border border-base-200 bg-white p-8 shadow-sm">
            <blockquote class="text-base text-base-800 flex-1">
              <p>“{testimonial.quote}”</p>
            </blockquote>
            <figcaption class="mt-6">
              <Text tag="h3" variant="textBase" class="font-semibold text-base-900">
                {testimonial.name}
              </Text>
              <p class="mt-1 text-xs text-base-500">{testimonial.role}</p>
              <a
                href={testimonial.href}
                class="mt-4 inline-flex items-center gap-1 text-sm font-medium text-accent-600 hover:text-accent-800"
              >
                Read more →
              </a>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </Wrapper>
</section>
