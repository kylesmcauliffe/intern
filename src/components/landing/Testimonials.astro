---
import { Image } from "astro:assets";
import Avatar1 from "@/images/assets/avatar1.jpeg";
import Avatar2 from "@/images/avatar2.jpeg";
import Avatar3 from "@/images/assets/avatar3.jpeg";
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
const testimonials = [
  {
    src: Avatar2,
    alt: "David Johnson",
    testimonial:
      "Working with this team has been an absolute pleasure. Their dedication and expertise have helped us achieve outstanding results.",
    name: "David Johnson",
    role: "Marketing Manager, Acme Corp",
  },
  {
    src: Avatar1,
    alt: "Sarah Adams",
    testimonial:
      "I am continually impressed by their professionalism and commitment to excellence. They consistently deliver top-notch work on time and within budget.",
    name: "Sarah Adams",
    role: "Creative Director, XYZ Design Studio",
  },
  {
    src: Avatar3,
    alt: "Michael Smith",
    testimonial:
      "I highly recommend this team to anyone seeking reliable and skilled web development services. They are responsive, proactive, and always exceed expectations.",
    name: "Michael Smith",
    role: "Founder & CEO, Tech Innovations Inc",
  },
];
---

<section class="bg-base-50 overflow-hidden relative">
  <Wrapper variant="standard" class="py-24">
    <span
      class="inline-flex rounded-full bg-base-200 px-3 py-1 text-[11px] font-medium uppercase tracking-widest text-base-600"
    >
      Voices
    </span>
    <Text
      tag="h2"
      variant="displayMD"
      class="tracking-tight text-base-900 mt-6 text-balance max-w-2xl"
    >
      Interns and partners have something to say
    </Text>
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3 mt-12">
      {
        testimonials.map((testimonial) => (
          <figure class="flex flex-col rounded-3xl border border-base-200 bg-white p-8 shadow-sm">
            <Image
              width={80}
              height={80}
              src={testimonial.src}
              alt={testimonial.alt}
              class="size-14 rounded-full object-cover"
            />
            <blockquote class="mt-6 text-base text-base-800">
              <p>“{testimonial.testimonial}”</p>
            </blockquote>
            <figcaption class="mt-6">
              <Text tag="h3" variant="textBase" class="font-semibold text-base-900">
                {testimonial.name}
              </Text>
              <p class="mt-1 text-xs text-base-500">{testimonial.role}</p>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </Wrapper>
</section>
