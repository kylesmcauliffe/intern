---
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
const reasons = [
  {
    step: "02",
    term: "Expertise",
    description:
      "Coaches with studio and in-house experience who will actually mark your work.",
  },
  {
    step: "03",
    term: "Innovation",
    description:
      "Current tools — Notion, Figma, Canva, and this Astro site — used the way teams ship.",
  },
  {
    step: "04",
    term: "Collaboration",
    description:
      "Critique is scheduled, not performative. You leave with a shared language.",
  },
  {
    step: "05",
    term: "Quality",
    description:
      "One brand system across site and intern workspaces, so nothing drifts.",
  },
];
---

<section class="bg-base-50 overflow-hidden relative">
  <Wrapper variant="standard" class="py-24">
    <p class="text-sm font-medium text-accent-600">02 · Hydrate</p>
    <Text
      tag="h2"
      variant="displayMD"
      class="tracking-tight text-base-900 mt-4 text-balance max-w-2xl"
    >
      Why this program, not another internship
    </Text>
    <dl class="mt-16 grid gap-6 sm:grid-cols-2">
      {
        reasons.map((reason) => (
          <div class="rounded-3xl border border-base-200 bg-white p-8 shadow-sm">
            <dt class="text-xs uppercase tracking-widest text-accent-600">
              {reason.step} · {reason.term}
            </dt>
            <dd class="mt-4 text-base-700 text-pretty">{reason.description}</dd>
          </div>
        ))
      }
    </dl>
  </Wrapper>
</section>
