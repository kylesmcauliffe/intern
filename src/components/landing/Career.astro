---
import { Image } from "astro:assets";
import Text from "@/components/fundations/elements/Text.astro";
import Button from "@/components/fundations/elements/Button.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import headshot from "@/images/ariana/headshot.jpg";
---

<section class="bg-base-50 overflow-hidden relative">
  <Wrapper variant="standard" class="py-24">
    <div class="grid gap-12 lg:grid-cols-[auto_1fr] lg:items-start">
      <div class="shrink-0">
        <Image
          src={headshot}
          alt="Ariana Cirkelis"
          width={320}
          height={320}
          class="size-40 sm:size-48 rounded-full object-cover object-top shadow-sm ring-4 ring-base-100"
        />
      </div>
      <div>
        <span
          class="inline-flex rounded-full bg-base-200 px-3 py-1 text-[11px] font-medium uppercase tracking-widest text-base-600"
        >
          Career
        </span>
        <Text
          tag="h2"
          variant="displayMD"
          class="tracking-tight text-base-900 text-balance mt-6 max-w-2xl"
        >
          How I turned my internship into a full-time offer
        </Text>
        <p class="mt-3 text-sm font-medium text-accent-600">
          Healthcare Partnerships @ Uber · San Francisco
        </p>
        <div class="mt-8 max-w-2xl space-y-4 text-base-600 text-pretty">
          <Text tag="p" variant="textBase" class="font-medium text-base-900">
            I started as an intern too…
          </Text>
          <Text tag="p" variant="textBase">
            I started Intern to Impact because I know what it's like to be at the
            beginning of your career and have absolutely no idea what comes next.
          </Text>
          <Text tag="p" variant="textBase">
            I went from navigating college and internship applications to landing my
            first corporate internship, turning that experience into a full-time
            career, and eventually asking a completely different question: what do I
            actually want to build here?
          </Text>
          <Text tag="p" variant="textBase">
            Along the way, I realized there's endless advice about how to get the
            opportunity—but far less about what happens once you're actually through
            the door.
          </Text>
          <Text tag="p" variant="textBase">
            Intern to Impact is where I'm sharing what I've learned, the work that's
            helped me grow, and the stories of other young professionals figuring it
            out, too.
          </Text>
        </div>
        <div class="mt-10">
          <Button
            isLink
            size="base"
            variant="accent"
            href="https://www.linkedin.com/in/ariana-cirkelis/"
            target="_blank"
            rel="noopener noreferrer"
          >
            Let's connect on LinkedIn!
          </Button>
        </div>
      </div>
    </div>
  </Wrapper>
</section>
