---
import Text from "@/components/fundations/elements/Text.astro";
import Button from "@/components/fundations/elements/Button.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import { getCollection } from "astro:content";
const allServices = await getCollection("services");
---

<section class="bg-base-50 overflow-hidden relative">
  <Wrapper variant="standard" class="py-24">
    <div class="grid gap-12 lg:grid-cols-2 lg:items-center">
      <div>
        <p class="text-sm font-medium text-accent-600">01 · Enroll</p>
        <Text
          tag="h2"
          variant="displayMD"
          class="tracking-tight text-base-900 text-balance mt-4"
        >
          Every intern starts a live record
        </Text>
        <Text tag="p" variant="textLG" class="text-base-600 mt-6 text-balance">
          Skills, briefs, and critique live in one loop — so you deepen craft
          without performing polish you have not earned yet.
        </Text>
        <ul class="mt-8 flex flex-col gap-3">
          {
            allServices.map((post) => (
              <li class="text-base-800 text-lg border-b border-base-200 pb-3">
                {post.data.service}
              </li>
            ))
          }
        </ul>
        <div class="mt-8">
          <Button isLink size="base" variant="default" href="/services">
            See services
          </Button>
        </div>
      </div>
      <div class="rounded-[2rem] bg-accent-500 p-8 text-white shadow-sm">
        <p class="text-xs uppercase tracking-widest text-accent-100">
          Program snapshot
        </p>
        <p class="mt-6 font-display text-4xl tracking-tight">7.2 / cohort</p>
        <p class="mt-1 text-sm text-accent-100">New members enrolled</p>
        <p class="mt-8 font-display text-4xl tracking-tight">37</p>
        <p class="mt-1 text-sm text-accent-100">Case studies in review</p>
        <div
          class="mt-10 h-16 rounded-2xl bg-white/10"
          aria-hidden="true"
        >
        </div>
      </div>
    </div>
  </Wrapper>
</section>
