---
import Text from "@/components/fundations/elements/Text.astro";
import Button from "@/components/fundations/elements/Button.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import BlogCard2 from "@/components/blog/BlogCard2.astro";
import { getCollection } from "astro:content";

const allPosts = await getCollection("posts");
allPosts.sort((a, b) => {
  const dateA = new Date(a.data.pubDate).getTime();
  const dateB = new Date(b.data.pubDate).getTime();
  return dateB - dateA;
});
---

<section class="bg-base-50 overflow-hidden relative">
  <Wrapper variant="standard" class="py-24 relative">
    <div class="w-full max-w-xl">
      <span
        class="inline-flex rounded-full bg-base-200 px-3 py-1 text-[11px] font-medium uppercase tracking-widest text-base-600"
      >
        Latest articles
      </span>
      <Text
        tag="h2"
        variant="displayMD"
        class="tracking-tight text-base-900 text-balance mt-6"
      >
        From the blog
      </Text>
      <Text tag="p" variant="textLG" class="text-base-600 mt-6 text-balance">
        Notes on craft, presence, and shipping work you can stand behind.
      </Text>
      <div class="flex mt-8">
        <Button isLink size="base" variant="muted" href="/blog">
          Read all articles
        </Button>
      </div>
    </div>
    <div class="grid sm:grid-cols-2 lg:grid-cols-2 gap-x-12 gap-y-24 mt-24">
      {allPosts.slice(0, 2).map((post) => <BlogCard2 post={post} />)}
    </div>
  </Wrapper>
</section>
