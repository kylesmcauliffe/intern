---
const { className = "", ...rest } = Astro.props;
---

<span
  class:list={[
    "inline-flex items-center gap-2 font-sans font-semibold tracking-tight text-base-900",
    className,
  ]}
  {...rest}
>
  <svg
    class="size-6 sm:size-7 shrink-0"
    viewBox="0 0 32 32"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    aria-hidden="true"
  >
    <circle cx="16" cy="16" r="15" stroke="currentColor" stroke-width="1.5"
    ></circle>
    <g fill="currentColor">
      <rect x="9" y="9" width="3.2" height="3.2" rx="0.4"></rect>
      <rect x="14.4" y="9" width="3.2" height="3.2" rx="0.4"></rect>
      <rect x="19.8" y="9" width="3.2" height="3.2" rx="0.4"></rect>
      <rect x="9" y="14.4" width="3.2" height="3.2" rx="0.4"></rect>
      <rect x="14.4" y="14.4" width="3.2" height="3.2" rx="0.4"></rect>
      <rect x="19.8" y="14.4" width="3.2" height="3.2" rx="0.4"></rect>
      <rect x="9" y="19.8" width="3.2" height="3.2" rx="0.4"></rect>
      <rect x="14.4" y="19.8" width="3.2" height="3.2" rx="0.4"></rect>
      <rect x="19.8" y="19.8" width="3.2" height="3.2" rx="0.4"></rect>
    </g>
  </svg>
  Intern → Impact
</span>
