---
import Text from "@/components/fundations/elements/Text.astro";
import Button from "@/components/fundations/elements/Button.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
---

<section class="bg-base-50">
  <Wrapper variant="standard" class="py-12">
    <div
      class="flex flex-col gap-8 rounded-[2rem] bg-gradient-to-r from-accent-500 to-accent-700 px-8 py-16 text-white md:flex-row md:items-end md:justify-between lg:px-16"
    >
      <div class="max-w-xl">
        <p class="text-sm font-medium text-accent-100">08 · Apply</p>
        <Text
          tag="h2"
          variant="displayMD"
          class="tracking-tight text-white mt-4 text-balance"
        >
          Ready to get started?
        </Text>
        <Text tag="p" variant="textLG" class="text-accent-100 mt-4 text-balance">
          Tell us where you are in your career. You will get a reply, a brief,
          and a seat in the next critique.
        </Text>
      </div>
      <Button isLink size="lg" variant="muted" href="/contact">
        Talk to us
      </Button>
    </div>
  </Wrapper>
</section>
