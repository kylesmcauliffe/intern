---
import Text from "@/components/fundations/elements/Text.astro";
import Button from "@/components/fundations/elements/Button.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
---

<section class="bg-base-50">
  <Wrapper variant="standard" class="py-12">
    <div
      class="flex flex-col gap-8 rounded-[2rem] bg-gradient-to-r from-accent-500 to-accent-700 px-8 py-16 text-white md:flex-row md:items-end md:justify-between lg:px-16"
    >
      <div class="max-w-xl">
        <Text
          tag="h2"
          variant="displayMD"
          class="tracking-tight text-white mt-4 text-balance"
        >
          Let's Chat
        </Text>
        <Text tag="p" variant="textLG" class="text-accent-100 mt-4 text-balance">
          Have a question, an idea, or a story worth sharing? Let's grab a virtual
          coffee.
        </Text>
      </div>
      <Button isLink size="lg" variant="muted" href="/contact">
        Schedule a Coffee Chat →
      </Button>
    </div>
  </Wrapper>
</section>
