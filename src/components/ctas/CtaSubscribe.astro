---
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import Button from "@/components/fundations/elements/Button.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
---

<section class="bg-base-50">
  <Wrapper variant="standard" class="py-24">
    <div class="flex flex-col flex-shrink-0 gap-8 md:gap-12 max-w-xl">
      <div>
        <div class="relative max-w-xs">
          <div class="absolute inset-0 flex items-center" aria-hidden="true">
            <div class="w-full border-t border-accent-300"></div>
          </div>
          <div class="relative flex justify-start">
            <span class="bg-accent-500 pr-2 text-sm text-white font-medium"
              >The Newsletter</span
            >
          </div>
        </div>
        <Text
          tag="h2"
          variant="displayLG"
          class="tracking-tight text-base-900 mt-12 text-balance"
        >
          Career lessons, opportunities, and things I wish someone had told me
          sooner
        </Text>
        <Text tag="p" variant="textXL" class="text-base-600 mt-8 text-pretty">
          Straight to your inbox — practical advice from The Return Offer and
          Intern → Impact.
        </Text>
      </div>
      <div class="mt-4">
        <Button isLink size="lg" variant="accent" href="/apply">
          Join the newsletter
        </Button>
      </div>
    </div>
  </Wrapper>
</section>
