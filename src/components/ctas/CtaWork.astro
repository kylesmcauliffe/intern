---
import Text from "@/components/fundations/elements/Text.astro";
import Button from "@/components/fundations/elements/Button.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
---

<section class="bg-base-50">
  <Wrapper variant="standard" class="py-24">
    <div
      class="rounded-[2rem] bg-gradient-to-r from-accent-500 to-accent-700 px-8 py-16 text-center text-white lg:px-16"
    >
      <p class="text-sm font-medium text-accent-100">Join us</p>
      <Text
        tag="h1"
        variant="displayXL"
        class="tracking-tight text-white text-balance mt-4"
      >
        Want to jam with us?
      </Text>
      <Text tag="p" variant="textLG" class="text-accent-100 mt-6 text-balance max-w-xl mx-auto">
        We are a multi-disciplinary team building intern-ready systems. If that
        sounds like you, apply for the next cohort.
      </Text>
      <div class="mt-8 flex justify-center">
        <Button isLink size="lg" variant="muted" href="/contact">Apply</Button>
      </div>
    </div>
  </Wrapper>
</section>
